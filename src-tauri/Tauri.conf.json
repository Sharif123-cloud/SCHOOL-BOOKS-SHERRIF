{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "app",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "identifier": "com.tauri.dev",
      "icon": [],
      "resources": [],
      "copyright": "",
      "shortDescription": "",
      "longDescription": "",
      "deb": {
        "depends": [],
        "conflicts": [],
        "provides": [],
        "replaces": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "",
        "exceptionDomain": "",
        "signingIdentity": "",
        "entitlements": null,
        "hardenedRuntime": false
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "windows": [
      {
        "title": "Student Reader",
        "width": 1200,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
